{
  "name": "@pdo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "example": "rm -f public/examples/todo.obj && ../target/release/pdo new public/examples/todo.obj --class Todo --name todo --from ../examples/todo",
    "test": "bun test/runtime.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "astro": "^5.7.0",
    "es-module-lexer": "^3.0.5",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.105.0"
  }
}
