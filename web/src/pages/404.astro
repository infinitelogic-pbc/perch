---
import Base from '../layouts/Base.astro';
---
<Base title="Not found: pdo" description="No such page.">
  <div class="wrap nf stack">
    <p class="eyebrow">404</p>
    <h1 class="mono">no such table</h1>
    <p>That page is not in this file. Try the <a href="/">overview</a> or <a href="/format">the format</a>.</p>
  </div>
</Base>

<style>
  .nf { padding: clamp(3rem, 10vw, 7rem) var(--gutter); }
  h1 { font-size: clamp(2rem, 1.4rem + 3vw, 3.2rem); letter-spacing: -0.03em; }
</style>
