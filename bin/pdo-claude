#!/usr/bin/env bash
# Open a Claude session hooked to one portable durable object.
#
#   pdo-claude my.obj                 # creates my.obj (empty class) if it is missing
#   pdo-claude my.obj --class Shop    # class name for a new object
#   pdo-claude my.obj -- --model sonnet "build a guestbook"   # extra args go to claude
#
# Claude starts in a fresh, empty temp directory with only this object's MCP
# tools attached, so it works on the object and nothing else.
set -euo pipefail

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

obj="" class="" claude_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --class) class="${2:?--class needs a name}"; shift 2 ;;
    --) shift; claude_args=("$@"); break ;;
    -*) echo "pdo-claude: unknown option $1" >&2; usage 2 ;;
    *) [ -z "$obj" ] || { echo "pdo-claude: one object file at a time" >&2; exit 2; }; obj="$1"; shift ;;
  esac
done
[ -n "$obj" ] || usage 2

# Find the pdo binary: $PDO, then this checkout's build, then PATH.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${PDO:-}" ]; then pdo="$PDO"
elif [ -x "$here/../target/release/pdo" ]; then pdo="$here/../target/release/pdo"
elif command -v pdo >/dev/null 2>&1; then pdo="$(command -v pdo)"
else echo "pdo-claude: no pdo binary. Build it (cd pdo && cargo build --release) or set PDO=/path/to/pdo" >&2; exit 1
fi
pdo="$(cd "$(dirname "$pdo")" && pwd)/$(basename "$pdo")"
command -v claude >/dev/null 2>&1 || { echo "pdo-claude: the claude CLI is not on PATH" >&2; exit 1; }

if [ ! -e "$obj" ]; then
  mkdir -p "$(dirname "$obj")"
  "$pdo" new "$obj" ${class:+--class "$class"} >/dev/null
  echo "pdo-claude: created $obj" >&2
fi
obj="$(cd "$(dirname "$obj")" && pwd)/$(basename "$obj")"
"$pdo" describe "$obj" >/dev/null   # fail early if it is not an object file

work="$(mktemp -d "${TMPDIR:-/tmp}/pdo-claude.XXXXXX")"
trap 'rm -rf "$work"' EXIT
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
config="{\"mcpServers\":{\"pdo\":{\"command\":\"$(esc "$pdo")\",\"args\":[\"mcp\",\"$(esc "$obj")\"]}}}"

echo "pdo-claude: object $obj" >&2
echo "pdo-claude: serve it from another terminal with: $pdo run $obj" >&2
cd "$work"
claude --strict-mcp-config --mcp-config "$config" ${claude_args[@]+"${claude_args[@]}"}
