#!/usr/bin/env bash
# Open an oh-my-pi (omp) session hooked to one portable durable object.
#
#   perch-omp my.perch                 # creates my.perch (empty class) if it is missing
#   perch-omp my.perch --class Shop    # class name for a new object
#   perch-omp my.perch -- --model opus "build a guestbook"   # extra args go to omp
#
# omp starts in a fresh, empty temp directory whose .omp/mcp.json attaches this
# object's MCP tools, so it works on the object and not on a codebase.
set -euo pipefail

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

obj="" class="" omp_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --class) class="${2:?--class needs a name}"; shift 2 ;;
    --) shift; omp_args=("$@"); break ;;
    -*) echo "perch-omp: unknown option $1" >&2; usage 2 ;;
    *) [ -z "$obj" ] || { echo "perch-omp: one object file at a time" >&2; exit 2; }; obj="$1"; shift ;;
  esac
done
[ -n "$obj" ] || usage 2

# Find the perch binary: $PERCH, then this checkout's build, then PATH.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${PERCH:-}" ]; then perch="$PERCH"
elif [ -x "$here/../target/release/perch" ]; then perch="$here/../target/release/perch"
elif command -v perch >/dev/null 2>&1; then perch="$(command -v perch)"
else echo "perch-omp: no perch binary. Build it (cargo build --release in the perch checkout) or set PERCH=/path/to/perch" >&2; exit 1
fi
perch="$(cd "$(dirname "$perch")" && pwd)/$(basename "$perch")"
command -v omp >/dev/null 2>&1 || { echo "perch-omp: the omp CLI (oh-my-pi) is not on PATH" >&2; exit 1; }

if [ ! -e "$obj" ]; then
  mkdir -p "$(dirname "$obj")"
  "$perch" new "$obj" ${class:+--class "$class"} >/dev/null
  echo "perch-omp: created $obj" >&2
fi
obj="$(cd "$(dirname "$obj")" && pwd)/$(basename "$obj")"
"$perch" describe "$obj" >/dev/null   # fail early if it is not an object file

work="$(mktemp -d "${TMPDIR:-/tmp}/perch-omp.XXXXXX")"
trap 'rm -rf "$work"' EXIT
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
mkdir -p "$work/.omp"
printf '{"mcpServers":{"perch":{"type":"stdio","command":"%s","args":["mcp","%s"]}}}\n' "$(esc "$perch")" "$(esc "$obj")" > "$work/.omp/mcp.json"

echo "perch-omp: object $obj" >&2
echo "perch-omp: serve it from another terminal with: $perch run $obj" >&2
cd "$work"
omp ${omp_args[@]+"${omp_args[@]}"}
